# Demo is deterministic and uses synthetic data. No API key is required.
SUPPORTOPS_MODE=demo
SUPPORTOPS_DATABASE_URL=sqlite:///./var/supportops.db
SUPPORTOPS_CHECKPOINT_URL=sqlite:///./var/checkpoints.db
SUPPORTOPS_AUTH_MODE=demo
SUPPORTOPS_WORKER_ENABLED=true
# Live inference: set MODE=live, AUTH_MODE=oidc for public deployments.
# SupportOps uses only configured provider URLs; user content cannot select destinations.
SUPPORTOPS_API_KEY=
SUPPORTOPS_BASE_URL=https://api.openai.com/v1
SUPPORTOPS_SMALL_MODEL=gpt-4.1-mini
SUPPORTOPS_REASONING_MODEL=gpt-4.1
SUPPORTOPS_FALLBACK_MODEL=
SUPPORTOPS_FALLBACK_BASE_URL=
SUPPORTOPS_FALLBACK_API_KEY=
SUPPORTOPS_EMBEDDING_MODEL=text-embedding-3-small
SUPPORTOPS_ENABLE_GUARDRAILS=false
SUPPORTOPS_OTLP_ENDPOINT=
SUPPORTOPS_OIDC_ISSUER=
SUPPORTOPS_OIDC_AUDIENCE=
SUPPORTOPS_OIDC_JWKS_URL=
# Pricing is intentionally unset. Configure your current contracted USD / million tokens.
SUPPORTOPS_MODEL_PRICES={}

# Use local lexical-hash retrieval with a live LLM if embeddings are unavailable.
SUPPORTOPS_EMBEDDING_MODE=auto

SUPPORTOPS_MODEL_OUTPUT_TOKENS=4000
SUPPORTOPS_MODEL_CALL_TIMEOUT_SECONDS=45
